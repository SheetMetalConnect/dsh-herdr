{
  "name": "dsh-herdr",
  "version": "0.2.0",
  "description": "DeepSeek Harness in your terminal, wired into Herdr: an interactive ACP client with live pane state and one-key handoff to the harness web UI.",
  "license": "MIT",
  "type": "module",
  "main": "src/bridge.js",
  "bin": {
    "dsx": "src/cli.js",
    "herdr-report": "bin/herdr-report.js"
  },
  "files": [
    "src",
    "bin",
    "adapters",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/bridge.js && node --check bin/herdr-report.js && node --check adapters/dsh/plugin.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "herdr",
    "acp",
    "tui",
    "coding-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SheetMetalConnect/dsh-herdr.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./src/bridge.js",
    "./adapters/dsh": "./adapters/dsh/plugin.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0"
  }
}
